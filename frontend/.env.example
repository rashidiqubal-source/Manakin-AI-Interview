# ─────────────────────────────────────────────────────────────────
#  AI Interview — Frontend Environment Variables
#  Copy this file to .env.local for local overrides.
# ─────────────────────────────────────────────────────────────────

# Backend REST API base URL
# In local development: http://localhost:3000/api/v1
# In production: https://your-backend-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Backend Socket.IO URL for proctoring WebSocket connections
# In local development: http://localhost:3000
# In production: https://your-backend-api.onrender.com
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# NEXT_PUBLIC_API_URL="https://manakin-ai-interview.onrender.com/api/v1"
# NEXT_PUBLIC_SOCKET_URL="https://manakin-ai-interview.onrender.com"
