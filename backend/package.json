  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "ml": "./ml_service/venv/bin/python ml_service/server.py",
    "ml:dev": "./ml_service/venv/bin/python ml_service/server.py",
    "build": "npx prisma generate && tsc",
    "start": "npx prisma db push && node --max-old-space-size=460 dist/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest --testPathIgnorePatterns=e2e-interview-flow --runInBand",
    "test:e2e": "jest --testMatch=**/src/test/e2e-*.test.ts --runInBand"
  },
