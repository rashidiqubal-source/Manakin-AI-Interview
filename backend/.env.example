# ─────────────────────────────────────────────────────────────────
#  AI Interview — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test
CORS_ORIGIN="http://localhost:3001" # Set to your exact frontend origin (e.g. https://yourdomain.com)
FRONTEND_URL="http://localhost:3001"

# ── Authentication & Security ──────────────────────────────────────
# Secret key used for cryptographic session signature/verification
SESSION_SECRET="generate-a-strong-random-secret-key-at-least-32-characters"
SESSION_COOKIE_NAME="ai_interview_session"
SESSION_EXPIRES_DAYS=7
COOKIE_SAME_SITE="lax"        # lax | strict | none
COOKIE_SECURE=false           # set to true in production with HTTPS
COOKIE_DOMAIN=""              # optional domain, e.g. .yourdomain.com

# ── Auth Rate Limiting ─────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_SIGNIN=10
AUTH_RATE_LIMIT_MAX_SIGNUP=5
AUTH_RATE_LIMIT_MAX_FORGOT_PW=5

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── AI — OpenAI ───────────────────────────────────────────────────
# Required. Used for Whisper STT (whisper-1) and chat/evaluation (gpt-4o-mini).
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# ── AI — Google Gemini (Optional) ────────────────────────────────
# When set, Gemini acts as the PRIMARY LLM; OpenAI is the fallback.
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ── Email — Mailero (Optional) ────────────────────────────────────
# Required only if you want automated acceptance/rejection emails sent to candidates.
MAILERO_HOST="smtp.mailersend.net"
MAILERO_PORT=587
MAILERO_USERNAME="your_mailero_username"
MAILERO_PASSWORD="your_mailero_password"
MAILERO_SENDING_KEY="mlsn.your_sending_key_here"
MAILERO_FROM="\"AI Interview Platform\" <careers@example.com>"
